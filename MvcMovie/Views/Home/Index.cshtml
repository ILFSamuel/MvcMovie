@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <h1 class="display-5">MvcMovie</h1>
    <p class="text-body-secondary">compito</p>
</div>

<div class="row g-4">

    <!-- Contatore -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Contatore</h5>
                <p class="display-4" id="counterValue">0</p>
                <div class="btn-group">
                    <button class="btn btn-outline-danger" id="btnMinus">−</button>
                    <button class="btn btn-outline-secondary" id="btnReset">Reset</button>
                    <button class="btn btn-outline-success" id="btnPlus">+</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Notifiche</h5>
                <p class="card-text">Mostra un messaggio temporaneo.</p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button class="btn btn-success" onclick="showToast('Operazione riuscita!', 'success')">Successo</button>
                    <button class="btn btn-warning" onclick="showToast('Attenzione!', 'warning')">Avviso</button>
                    <button class="btn btn-danger" onclick="showToast('Qualcosa è andato storto', 'danger')">Errore</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modale di conferma + pulsante con caricamento -->
    <div class="col-12 col-md-6 col-lg-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Azioni</h5>
                <p class="card-text">Conferma prima di procedere, oppure simula un caricamento.</p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <button class="btn btn-outline-danger" id="btnDelete">Elimina…</button>
                    <button class="btn btn-primary" id="btnLoad">
                        <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                        <span class="label">Carica dati</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Contenuto comprimibile -->
    <div class="col-12">
        <button class="btn btn-link p-0" data-bs-toggle="collapse" data-bs-target="#moreInfo">
            Mostra/nascondi dettagli
        </button>
        <div class="collapse mt-2" id="moreInfo">
            <div class="card card-body">
                Questo blocco usa il componente <code>collapse</code> di Bootstrap, senza JavaScript personalizzato.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Contatore
        let count = 0;
        const value = document.getElementById("counterValue");
        const render = () => value.textContent = count;

        document.getElementById("btnPlus").onclick  = () => { count++; render(); };
        document.getElementById("btnMinus").onclick = () => { count--; render(); };
        document.getElementById("btnReset").onclick = () => { count = 0; render(); showToast("Contatore azzerato", "info"); };

        // Modale di conferma
        document.getElementById("btnDelete").onclick = () =>
            confirmAction("Elimina elemento", "L'operazione non può essere annullata. Continuare?",
                () => showToast("Elemento eliminato", "danger"));

        // Pulsante con spinner
        document.getElementById("btnLoad").onclick = function () {
            const btn = this;
            btn.disabled = true;
            btn.querySelector(".spinner-border").classList.remove("d-none");
            btn.querySelector(".label").textContent = "Caricamento...";

            setTimeout(() => {
                btn.disabled = false;
                btn.querySelector(".spinner-border").classList.add("d-none");
                btn.querySelector(".label").textContent = "Carica dati";
                showToast("Dati caricati!", "success");
            }, 1500);
        };
    </script>
}